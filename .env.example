# Copy this file to .env and fill values from your Supabase project.
# Project Settings > API > Project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Project Settings > API > anon public key.
# Never put the service-role key in the desktop app or installer.
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Optional development override.
# Production uses %LOCALAPPDATA%\RetailPOS\pos.db.
# POS_DB_PATH=pos.dev.db

# Optional local demo data.
# Keep false/empty for production builds because assets/products is not packaged.
# ENABLE_DEMO_SEED=false
